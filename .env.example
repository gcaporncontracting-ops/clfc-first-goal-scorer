APP_ENV=development

# Cloudflare D1 — bound as DB in wrangler.toml, no connection string needed
# (D1 is accessed via the Workers runtime binding, not a URL).

# Player PIN authentication is shared with Warriors-vote-v2 via the VOTES_KV
# binding in wrangler.toml — there is no separate PIN_HASH for this app.
# A universal testing PIN (0000) is hardcoded in src/worker.js for Phase 1
# and should be removed once real per-player PIN auth is the only path.

PLAYERHQ_MOCK_MODE=true
PLAYERHQ_API_BASE_URL=
PLAYERHQ_API_KEY=
PLAYERHQ_CLIENT_ID=
PLAYERHQ_CLIENT_SECRET=

PAYID_EMAIL=playersfund@clfc.com
ENTRY_FEE=2
EXPECTED_PLAYERS=22

# Phase 1 stopgap admin passcode (Phase 2 will replace this with a proper
# admin dashboard + auth). Change before real money is involved.
ADMIN_PASSCODE=94172079
